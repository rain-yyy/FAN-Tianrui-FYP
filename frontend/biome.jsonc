{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true        // 自动跳过 .gitignore 里的文件
  },
  "files": {
    "includes": ["src/**", "!**/dist", "!**/*.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn"   // 检查 Hooks 依赖数组
      }
    },
    "domains": {
      "react": "recommended"     // 启用 React 相关规则
    }
  },
  "assist": {
    "actions": {
      "source": { "organizeImports": "on" }   // 自动整理 import 顺序
    }
  }
}
{
    "ai_models": {
      "provider": "openrouter",
      "models": {
        "hyde_generation": "google/gemini-3.1-flash-lite",
        "wiki_structure": "anthropic/claude-sonnet-4.5",
        "wiki_content": "deepseek/deepseek-v3.2",
        "community_summary": "google/gemini-3.1-flash-lite",
        "chat_title": "qwen/qwen3.7-flash",
        "chat_agent": "openai/gpt-5.1",
        "chat_session_compressor": "google/gemini-3.5-flash-lite",
        "embedding": "qwen/qwen3-embedding-8b"
      }
    },
    "chat": {
      "max_tool_iterations": 6,
      "context_token_budget": 12000,
      "reserved_output_tokens": 2000,
      "history_summary_trigger_messages": 20,
      "hybrid_dense_weight": 0.6,
      "hybrid_sparse_weight": 0.4,
      "mmr_lambda": 0.5,
      "dense_k_multiplier": 4,
      "sparse_k_multiplier": 3,
      "max_method_k": 30,
      "max_total_candidates": 50,
      "category_top_k": { "code": 20, "text": 20 },
      "hyde_enabled": true
    },
    "wiki_generation": {
      "content_concurrency": 3,
      "rag_retry_delays_sec": [30, 120, 300]
    },
    "ingestion": {
      "embedding_inner_batch_size": 20,
      "embedding_inner_batch_sleep_sec": 1.0,
      "vector_store_batch_size": 50,
      "vector_store_inter_batch_sleep_sec": 2.0,
      "chunk_max_size": 2000,
      "chunk_overlap_size": 150,
      "code_chunk_min_size": 150,
      "code_chunk_max_size": 2000
    },
    "debug": {
      "save_wiki_structure_raw_responses": false,
      "save_rag_chunk_debug": false
    },
    "community_detection": {
      "file_level_collapse": true,
      "resolution_parameter": 0.55,
      "cross_file_call_weight": 1.0,
      "same_directory_chain_weight": 0.22,
      "merge_min_distinct_files": 2,
      "merge_prefix_parts": 2,
      "leiden_seed": 42
    },
    "web_search": {
      "provider": "duckduckgo",
      "tavily_api_key": "",
      "serpapi_key": "",
      "allowed_domains": [
        "docs.python.org",
        "github.com",
        "pypi.org",
        "npmjs.com",
        "docs.rs",
        "crates.io",
        "pkg.go.dev",
        "developer.mozilla.org",
        "stackoverflow.com",
        "nvd.nist.gov"
      ],
      "timeout": 10,
      "max_results": 5
    }
  }
  